APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
LIVEWIRE_TEMP_DISK=livewire-tmp
LIVEWIRE_TEMP_DIRECTORY=livewire-tmp
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Titan Email (smtp.titan.email:465). The password is the mailbox password
# for help@listenai.studio, also editable under Newsletter → Mailbox.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.titan.email
MAIL_PORT=465
MAIL_USERNAME=help@listenai.studio
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="help@listenai.studio"
MAIL_FROM_NAME="Listen"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

LISTEN_API_KEY=

# Social OAuth login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/social/callback
GOOGLE_OAUTH_VERIFY_SSL=true

# Speech engine
SPEECH_TTS_API_KEY=
SPEECH_TTS_CREDENTIALS_JSON=
SPEECH_TTS_CREDENTIALS_PATH=
SPEECH_TTS_ENDPOINT=https://texttospeech.googleapis.com/v1/text:synthesize
SPEECH_TTS_TOKEN_URI=https://oauth2.googleapis.com/token
SPEECH_TTS_VERIFY_SSL=true
SPEECH_TTS_AUDIO_ENCODING=MP3
SPEECH_TTS_SPEAKING_RATE=0.95
SPEECH_TTS_PITCH=0.0
SPEECH_TTS_TIMEOUT_SECONDS=30

# Gemini HD speech. GEMINI_TTS_API_KEY_2, _3, ... add more keys.
# The admin TTS settings page overrides GEMINI_TTS_MODEL after it is saved.
GEMINI_TTS_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
GEMINI_TTS_DEFAULT_VOICE=Kore
GEMINI_TTS_TIMEOUT=60
# Per-key budgets the app tracks before it skips a key. Set them to your
# Gemini tier's limits; the defaults are the free tier. Run
# `php artisan config:cache` after changing them.
GEMINI_TTS_RPM_LIMIT=10
GEMINI_TTS_TPM_LIMIT=10000
GEMINI_TTS_RPD_LIMIT=100
# Extra attempts after a Gemini 5xx or a reply without audio.
GEMINI_TTS_TRANSIENT_RETRIES=2
GEMINI_TTS_RETRY_PAUSE_MS=600

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_STUDIO_MAX_MONTHLY=
STRIPE_PRICE_STUDIO_MAX_YEARLY=
LISTEN_BILLING_REQUIRE_SAVED_PAYMENT_METHOD=true
LISTEN_BILLING_GRACE_DAYS=7
LISTEN_BILLING_WEBHOOK_EMAILS=true

LISTEN_AUDIO_PROCESSING=sync
LISTEN_AUDIO_FORCE_ASYNC_CHARS=2500
LISTEN_DEFAULT_VOICE_TIER=standard
LISTEN_SUBSCRIPTION_SYNC_TTL_MINUTES=10
DEMO_GUEST_CHAR_ALLOWANCE=300
DEMO_USER_CHAR_ALLOWANCE=30000
DEMO_CHECK_GUEST_RATE_PER_MINUTE=30
DEMO_CHECK_USER_RATE_PER_MINUTE=120
DEMO_CHECK_GUEST_DAILY_REQUESTS=200
DEMO_CHECK_USER_DAILY_REQUESTS=1000
DEMO_CHECK_GUEST_DAILY_CHARS=300
DEMO_CHECK_USER_DAILY_CHARS=200000
DEMO_PREVIEW_GUEST_RATE_PER_MINUTE=3
DEMO_PREVIEW_USER_RATE_PER_MINUTE=12
DEMO_PREVIEW_GUEST_DAILY_REQUESTS=12
DEMO_PREVIEW_USER_DAILY_REQUESTS=150
DEMO_PREVIEW_GUEST_DAILY_CHARS=300
DEMO_PREVIEW_USER_DAILY_CHARS=50000
DEMO_GLOBAL_PREVIEW_DAILY_REQUESTS=3000
DEMO_GLOBAL_PREVIEW_DAILY_CHARS=500000

VITE_APP_NAME="${APP_NAME}"
