<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Application theme (dialogs, share sheet tint). Follows the phone's light/dark setting. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/site_background</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/site_background</item>
    </style>

    <!-- The theme the WebView screen runs with (Capacitor applies it by this exact name). -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/site_background</item>
    </style>

    <!-- Launch screen: the logo on the site's background, then hands over to the theme above. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/site_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
