<?xml version="1.0" encoding="utf-8"?>
<!--
  Replaces Capacitor's own layout of the same name (BridgeActivity inflates it by name).
  The outer frame is padded with the system-bar and keyboard insets; the WebView sits inside
  a pull-to-refresh container that stays off until a page turns it on.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/listen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/site_background">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/listen_swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.getcapacitor.CapacitorWebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</FrameLayout>
