<?xml version="1.0" encoding="utf-8"?>
<!--
  Lint runs with its default checks and fails the build on any error.
  The few entries below silence specific findings that were looked at and are not problems.
-->
<lint>
    <!-- The launch-screen logo is 288dp by Android's splash-screen specification. It is drawn once. -->
    <issue id="VectorRaster">
        <ignore path="src/main/res/drawable/splash_icon.xml" />
    </issue>

    <!-- Both are used, but not from this module's code: the layout replaces Capacitor's layout
         of the same name, and config.xml is generated by `npx cap sync` and read by Capacitor. -->
    <issue id="UnusedResources">
        <ignore path="src/main/res/layout/capacitor_bridge_layout_main.xml" />
        <ignore path="src/main/res/xml/config.xml" />
    </issue>

    <!-- The frame behind the WebView paints the site's background on purpose: it is what shows
         behind the transparent status and navigation bars, and it changes with the site's theme. -->
    <issue id="Overdraw">
        <ignore path="src/main/res/layout/capacitor_bridge_layout_main.xml" />
    </issue>

    <!-- The permission dialogs are shown in the page's language, which may differ from the phone's.
         That is safe because app/build.gradle turns language splitting off (bundle.language.enableSplit
         = false), so every install contains both Arabic and English. Lint does not see that setting. -->
    <issue id="AppBundleLocaleChanges">
        <ignore path="src/main/java/studio/listenai/app/ListenShellPlugin.java" />
    </issue>

    <!-- The Gradle wrapper and Android Gradle Plugin versions are the ones Capacitor 8 ships with;
         they are upgraded together with Capacitor, not one by one. -->
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
</lint>
