declare(strict_types=1);

namespace Listen\VoiceAgent;

if (!defined('ABSPATH')) {
    exit;
}

// Only one copy of the plugin runs, even if it was uploaded twice.
if (defined(__NAMESPACE__ . '\VERSION')) {
    return;
}

const VERSION = '{{VERSION}}';

// This website's agent. Listen wrote these when the plugin was downloaded: the agent's
// key, the button's script, your agents in Listen, and this agent's own page there.
const AGENT_KEY = {{KEY_PHP}};
const SCRIPT_URL = {{SCRIPT_PHP}};
const MANAGE_URL = {{MANAGE_PHP}};
const AGENT_URL = {{AGENT_PHP}};
// Signs a signed-in user's name and email for this agent when "Show who is calling" is on,
// so Listen knows they came from this website. It stays in this file, on your server.
const CALLER_SECRET = {{CALLER_SECRET_PHP}};

const PLUGIN_FILE = __FILE__;

// This file stays readable by older PHP, so a server moved to an older PHP after the
// plugin was activated shows a clear message instead of an error. WordPress itself
// refuses to activate the plugin below PHP 8.1 (see "Requires PHP" above).
if (PHP_VERSION_ID < 80100) {
    add_action('admin_notices', function () {
        if (!current_user_can('activate_plugins')) {
            return;
        }
        load_plugin_textdomain('listen-voice-agent', false, dirname(plugin_basename(PLUGIN_FILE)) . '/languages');
        printf(
            '<div class="notice notice-error"><p>%s</p></div>',
            esc_html(sprintf(
                /* translators: %s: the PHP version this website runs, for example 7.4.33. */
                __('Listen Voice Agent needs PHP 8.1 or newer, and this website runs PHP %s. The call button stays off until your host updates PHP.', 'listen-voice-agent'),
                PHP_VERSION
            ))
        );
    });

    return;
}

require_once __DIR__ . '/src/Placement.php';
require_once __DIR__ . '/src/Settings.php';
require_once __DIR__ . '/src/Pages.php';
require_once __DIR__ . '/src/SettingsPage.php';
require_once __DIR__ . '/src/Plugin.php';

Plugin::boot(PLUGIN_FILE);
