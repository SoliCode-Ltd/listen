<?php
/**
 * Plugin Name:       Listen Voice Agent
 * Plugin URI:        {{PRODUCT_URL}}
 * Description:       Adds your Listen voice agent's call button to your website, so visitors can talk to your business by voice, in their own dialect.
 * Version:           {{VERSION}}
 * Requires at least: 6.5
 * Requires PHP:      8.1
 * Author:            Listen
 * Author URI:        {{HOME}}
 * License:           GPL-2.0-or-later
 * License URI:       https://www.gnu.org/licenses/gpl-2.0.html
 * Text Domain:       listen-voice-agent
 * Domain Path:       /languages
 * Update URI:        false
 *
 * @package Listen\VoiceAgent
 */

